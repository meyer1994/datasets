# Single config for the docker compose stack, loaded by every service (env_file).
# Dev and prod use the same docker-compose.yml; only this file changes.

# MinIO / S3 — used by Dagster IO managers (s3fs) and Grafana's DuckDB secret.
# Also used as the MinIO root user/password.
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Grafana admin login (http://localhost:4000)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Dagster instance storage (dagster.yaml), also used as the postgres user/password/db.
# The postgres user/db are only created when the postgres_data volume is first initialized.
DAGSTER_PG_HOST=postgres
DAGSTER_PG_USERNAME=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels), read by cloudflared.
# Point the tunnel's public hostname at http://dagster-webserver:3000.
TUNNEL_TOKEN=
