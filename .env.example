# MinIO / S3 — used by Dagster IO managers (s3fs) and Grafana's DuckDB secret.
# Keys must match MINIO_ACCESS_KEY / MINIO_SECRET_KEY in docker-compose.yml.
# Compose overrides AWS_ENDPOINT_URL to http://minio:9000 for the grafana and dagster-* containers.
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Grafana admin login (http://localhost:3001)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# Dagster instance storage (dagster.yaml) and the compose postgres service.
# The postgres user/db are only created when the postgres_data volume is first initialized.
# Compose overrides DAGSTER_PG_HOST to postgres for the dagster-* containers.
DAGSTER_PG_HOST=localhost
DAGSTER_PG_USERNAME=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster
